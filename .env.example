# Copie ce fichier en ".env" et remplis tes vraies valeurs. Ne partage jamais ce fichier.

# Port du serveur
PORT=3000

# Session (mets une longue chaine aleatoire, sert a securiser les cookies de connexion admin)
SESSION_SECRET=change-moi-en-une-chaine-aleatoire-longue

# Compte admin (panneau de gestion du site, page /admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-moi

# PayPal (Developer Dashboard -> My Apps & Credentials -> cree une app "Live")
# https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Stripe (Dashboard -> Developers -> API keys)
# https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# URL publique du site une fois deploye (utile pour les redirections de paiement)
SITE_URL=http://localhost:3000
