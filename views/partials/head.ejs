<%
  const _title = typeof pageTitle !== 'undefined' ? pageTitle : 'Popstrap — Bracelets Royal Pop';
  const _desc = typeof pageDescription !== 'undefined' ? pageDescription : "Bracelets Royal Pop premium — biocéramique et caoutchouc, échange sans outil en 5 secondes. Une montre exigeante ne devrait pas être un luxe.";
  const _base = (typeof siteUrl !== 'undefined' && siteUrl) ? siteUrl.replace(/\/$/, '') : '';
  let _image = typeof pageImage !== 'undefined' ? pageImage : '/img/hero-banner.jpg';
  if (_image && !/^https?:\/\//.test(_image)) _image = _base + _image;
  const _noindex = typeof pageNoindex !== 'undefined' && pageNoindex;
%>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><%= _title %></title>
<meta name="description" content="<%= _desc %>" />
<% if (_noindex) { %><meta name="robots" content="noindex, nofollow" /><% } %>

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/favicon.png" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Popstrap" />
<meta property="og:title" content="<%= _title %>" />
<meta property="og:description" content="<%= _desc %>" />
<% if (_image) { %><meta property="og:image" content="<%= _image %>" /><% } %>
<meta name="twitter:card" content="summary_large_image" />

<link rel="stylesheet" href="/css/style.css" />
